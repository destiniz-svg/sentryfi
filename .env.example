# Local development. Railway sets these itself in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentryfi
JWT_SECRET=generate-your-own-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d
COOKIE_NAME=sentryfi_token
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=8000

# Receipt extraction. Without it the AI routes return an error rather than
# guessing; nothing else is affected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 only against a database whose certificate you cannot verify.
# DATABASE_SSL_NO_VERIFY=0
